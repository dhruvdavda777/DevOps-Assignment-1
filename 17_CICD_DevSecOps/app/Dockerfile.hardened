# The remediated image: current base, non-root, no build toolchain at runtime.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json ./
# mkdir first so the later COPY has a source even when there are no runtime deps.
RUN mkdir -p node_modules && npm install --omit=dev

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY package.json ./
COPY src ./src
USER node
ENV PORT=3000
EXPOSE 3000
CMD ["node", "src/server.js"]
